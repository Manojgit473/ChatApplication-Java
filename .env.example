# ========================================================
# Connect Chat - Environment Variables Configuration
# Copy this file to .env or set these in your terminal/system
# ========================================================

# Server Port
SERVER_PORT=8080

# MySQL Database Configuration
DB_HOST=localhost
DB_PORT=3306
DB_NAME=connect_chat_db
DB_USERNAME=root
DB_PASSWORD=your_mysql_password

# File Upload Configuration
UPLOAD_DIR=uploads/attachments
MAX_FILE_SIZE=10MB
MAX_REQUEST_SIZE=12MB

# Session Configuration
SESSION_TIMEOUT_MINUTES=120
